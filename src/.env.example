# Select one provider: foundry, azure_openai, github_models
INFERENCE_PROVIDER=github_models

# Foundry project endpoint (current Agent Framework docs use FoundryChatClient)
# AZURE_AI_PROJECT_ENDPOINT=https://<foundry-service>.services.ai.azure.com/api/projects/<project>
# AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4o-mini

# Azure OpenAI (current Python docs use OpenAIChatClient with explicit Azure routing)
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_CHAT_DEPLOYMENT_NAME=gpt-4o-mini
# AZURE_OPENAI_API_VERSION=2025-04-01-preview
# Optional: omit for Microsoft Entra ID via DefaultAzureCredential
# AZURE_OPENAI_API_KEY=

# GitHub Models (OpenAI-compatible)
# GITHUB_TOKEN=ghp_replace_me
# GITHUB_MODELS_MODEL=openai/gpt-4o-mini
