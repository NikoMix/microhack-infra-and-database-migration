<?xml version="1.0" encoding="utf-8"?>
<DTS:Executable xmlns:DTS="www.microsoft.com/SqlServer/Dts"
                DTS:refId="Package"
                DTS:CreationName="SSIS.Package.3"
                DTS:ExecutableType="SSIS.Package.3"
                DTS:ObjectName="TailwindStagingLoad"
                DTS:PackageType="5"
                DTS:VersionBuild="1"
                DTS:VersionGUID="{2F5C7A10-3E06-4F7E-9B24-68E6E7840002}"
                DTS:LocaleID="1033">
  <DTS:Property DTS:Name="PackageFormatVersion">8</DTS:Property>
  <DTS:Property DTS:Name="Description">Synthetic staging load package for source-order extracts.</DTS:Property>
  <DTS:ConnectionManagers>
    <DTS:ConnectionManager DTS:refId="Package.ConnectionManagers[TailwindOLTP]"
                           DTS:CreationName="OLEDB"
                           DTS:ObjectName="TailwindOLTP">
      <DTS:ObjectData>
        <DTS:ConnectionManager DTS:ConnectionString="Data Source=localhost;Initial Catalog=TailwindOLTP;Provider=SQLNCLI11.1;Integrated Security=SSPI;Auto Translate=False;" />
      </DTS:ObjectData>
    </DTS:ConnectionManager>
  </DTS:ConnectionManagers>
  <DTS:Variables />
  <DTS:Executables>
    <DTS:Executable DTS:refId="Package\Execute SQL Task - Prepare staging"
                    DTS:CreationName="Microsoft.ExecuteSQLTask"
                    DTS:ExecutableType="Microsoft.ExecuteSQLTask"
                    DTS:ObjectName="Execute SQL Task - Prepare staging">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask"
                             SQLTask:Connection="{TailwindOLTP}"
                             SQLTask:SqlStatementSource="IF OBJECT_ID('dbo.StageOrders','U') IS NULL CREATE TABLE dbo.StageOrders (OrderId bigint NOT NULL, CustomerId int NOT NULL, OrderDate datetime2(0) NOT NULL, OrderTotal decimal(14,2) NOT NULL); TRUNCATE TABLE dbo.StageOrders;" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\Data Flow Task - Load StageOrders"
                    DTS:CreationName="SSIS.Pipeline.3"
                    DTS:ExecutableType="SSIS.Pipeline.3"
                    DTS:ObjectName="Data Flow Task - Load StageOrders">
      <DTS:ObjectData>
        <pipeline version="1" xmlns="www.microsoft.com/sqlserver/dts/pipeline">
          <components>
            <component refId="Package\Data Flow Task - Load StageOrders\OLE DB Source"
                       componentClassID="DTSAdapter.OleDbSource"
                       name="OLE DB Source - Orders">
              <properties>
                <property name="SqlCommand">SELECT OrderId, CustomerId, OrderDate, OrderTotal FROM dbo.Orders;</property>
              </properties>
            </component>
            <component refId="Package\Data Flow Task - Load StageOrders\OLE DB Destination"
                       componentClassID="DTSAdapter.OleDbDestination"
                       name="OLE DB Destination - StageOrders">
              <properties>
                <property name="OpenRowset">dbo.StageOrders</property>
              </properties>
            </component>
          </components>
          <paths />
        </pipeline>
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
  <DTS:PrecedenceConstraints />
</DTS:Executable>
