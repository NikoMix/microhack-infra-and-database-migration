{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.44.1.10279",
      "templateHash": "3704757596406123658"
    }
  },
  "parameters": {
    "dataFactoryName": {
      "type": "string",
      "metadata": {
        "description": "Adds an Azure-SSIS Integration Runtime shell to an existing ADF for the SSIS migration challenge. Configure SSISDB/catalog parameters after SQL MI or Azure SQL catalog target is ready."
      }
    },
    "integrationRuntimeName": {
      "type": "string",
      "defaultValue": "ttmh-ssis-ir",
      "metadata": {
        "description": "Azure-SSIS IR name."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "nodeSize": {
      "type": "string",
      "defaultValue": "Standard_D2_v3",
      "metadata": {
        "description": "Azure-SSIS node size."
      }
    },
    "numberOfNodes": {
      "type": "int",
      "defaultValue": 1,
      "metadata": {
        "description": "Number of Azure-SSIS IR nodes."
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.DataFactory/factories/integrationRuntimes",
      "apiVersion": "2018-06-01",
      "name": "[format('{0}/{1}', parameters('dataFactoryName'), parameters('integrationRuntimeName'))]",
      "properties": {
        "type": "Managed",
        "typeProperties": {
          "computeProperties": {
            "location": "[parameters('location')]",
            "nodeSize": "[parameters('nodeSize')]",
            "numberOfNodes": "[parameters('numberOfNodes')]",
            "maxParallelExecutionsPerNode": 2
          }
        }
      }
    }
  ],
  "outputs": {
    "azureSsisIntegrationRuntimeName": {
      "type": "string",
      "value": "[parameters('integrationRuntimeName')]"
    }
  }
}